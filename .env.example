# LLM provider: configure only the provider you use.
OPENAI_API_KEY=replace-with-your-key
# ANTHROPIC_API_KEY=replace-with-your-key
# GOOGLE_API_KEY=replace-with-your-key

# Neuro SAN project paths are normally exported from Git Bash.
AGENT_MANIFEST_FILE=registries/manifest.hocon
AGENT_TOOL_PATH=coded_tools

# Frontend
NEURO_SAN_API_URL=http://localhost:8080
PDC_AGENT_NETWORK=pdc_product_generator
PDC_UI_HOST=127.0.0.1
PDC_UI_PORT=5002

# Optional approved catalog profile
# PDC_CATALOG_PROFILE=config/pdc_catalog_profile.json

# Optional Oracle PDC 15.2 installation XSD
# PDC_PRICING_XSD_PATH=C:/Oracle/PDC/apps/xsd/pricing-main.xsd
